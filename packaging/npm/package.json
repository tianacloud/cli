{
  "name": "@tianacloud/cli",
  "version": "0.2.2-beta.1",
  "description": "Tiana CLI for account login, SQLite, Git and application publication",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianacloud/cli.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "bin": {
    "tiana": "bin/tiana.mjs",
    "git-remote-tiana": "bin/git-remote-tiana.mjs"
  },
  "files": [
    "bin",
    "release.json",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node bin/install.mjs"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "riscv64"
  ]
}
